# === OS ===
.DS_Store
Thumbs.db
desktop.ini

# === Editor / IDE ===
.vscode/
.idea/
*.swp
*.swo
*~

# === Agent session state ===
# Track shared agent tooling (.claude/skills, a shared settings.json) but keep
# personal/local config out. settings.local.json is where Claude Code writes
# this machine's permission grants — never commit it.
.claude/settings.local.json
.cursor/

# === Node / npm / yarn / pnpm ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/
.yarn/cache
.yarn/install-state.gz

# === Build output (Vite client + Node server) ===
dist/
build/
.vite/
*.tsbuildinfo

# === Test / coverage ===
coverage/
.nyc_output/

# === Logs ===
logs/
*.log

# === Environment / secrets ===
# Track .env.example with placeholders; never commit real values.
.env
.env.local
.env.*.local
*.pem

# === Vercel (frontend deploy) ===
.vercel

# === Supabase CLI (local dev) ===
.supabase/

# === IB Client Portal Gateway (local runs) ===
# Anchored to repo root: we DO commit `infra/clientportal.gw/` (Dockerfile etc).
# The top-level `clientportal.gw/` is what appears when a user unzips IB's zip.
/clientportal.gw/
/ibgateway/
*.session
.ssh/*

# === IBeam credentials (Batch 13) ===
# IB account + password files live on the VPS in ~/upside/secrets/, mounted
# into the IBeam container at /run/secrets/. Never commit them.
/secrets/

# === Postgres connection string for the read-only inspection role ===
# Single line: postgresql://upside_readonly:<password>@<host>:5432/postgres?sslmode=require
# The role has SELECT-only grants on public.* (Postgres permissions are
# positive-only — no write surface exists for it) plus BYPASSRLS so dev
# inspection sees all rows regardless of RLS. Rotate by dropping the role
# and re-creating with a new password.
/.upside-readonly-db

# === Supabase session JWT for IB passthrough debugging (bin/upside-ib) ===
# Single line: the access_token copied from the PWA (Settings → Copy access
# token, or DevTools localStorage). A bearer credential — never commit.
# Expires ~1h; re-paste when calls start returning 401.
/.upside-token

# === Discord bot token for reading error channels (bin/upside-errors) ===
# Single line: the bot token from the Discord Developer Portal (Bot tab →
# Reset Token). A long-lived credential — never commit. Rotate via Reset Token.
/.upside-discord-token

# === Raw IB captures (Batch 7) ===
# May contain account identifiers from IB's responses. Never commit.
captures/

# === Browser network captures (HAR) ===
# Contain Authorization bearer tokens + full responses. Never commit.
network_captures/
*.har

