# === OS ===
.DS_Store
Thumbs.db
desktop.ini

# === Editor / IDE ===
.vscode/
.idea/
*.swp
*.swo
*~

# === Agent session state ===
# Track shared agent tooling (.claude/skills, a shared settings.json) but keep
# personal/local config out. settings.local.json is where Claude Code writes
# this machine's permission grants — never commit it.
.claude/settings.local.json
.cursor/

# === Node / npm / yarn / pnpm ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/
.yarn/cache
.yarn/install-state.gz

# === Build output (Vite client + Node server) ===
dist/
build/
.vite/
*.tsbuildinfo

# === Test / coverage ===
coverage/
.nyc_output/

# === Logs ===
logs/
*.log

# === Environment / secrets ===
# Track .env.example with placeholders; never commit real values.
.env
.env.local
.env.*.local
*.pem

# === Vercel (frontend deploy) ===
.vercel

# === Supabase CLI (local dev) ===
.supabase/

# === IB Client Portal Gateway (local runs) ===
# Anchored to repo root: we DO commit `infra/clientportal.gw/` (Dockerfile etc).
# The top-level `clientportal.gw/` is what appears when a user unzips IB's zip.
/clientportal.gw/
/ibgateway/
*.session
.ssh/*

# === IBeam credentials (Batch 13) ===
# IB account + password files live on the VPS in ~/upside/secrets/, mounted
# into the IBeam container at /run/secrets/. Never commit them.
/secrets/

# === Laptop dev-tooling credentials (.secrets/) ===
# Distinct from /secrets/ above (which holds the VPS IB account/password files
# mounted into IBeam). These are local credentials used by the bin/ helpers and
# the read-only skills. Never commit. Each file is a single line:
#   .secrets/readonly-db    — postgres conn string for the upside_readonly role
#                             (SELECT-only + BYPASSRLS). Rotate: drop + recreate
#                             the role with a new password.
#   .secrets/supabase-jwt   — Supabase access_token for IB passthrough debugging
#                             (bin/upside-ib). Bearer; expires ~1h; re-paste on 401.
#   .secrets/discord-token  — Discord bot token for reading error channels
#                             (bin/upside-errors). Long-lived; rotate via Reset Token.
/.secrets/

# === Raw IB captures (Batch 7) ===
# May contain account identifiers from IB's responses. Never commit.
captures/

# === Browser network captures (HAR) ===
# Contain Authorization bearer tokens + full responses. Never commit.
network_captures/
*.har

# === Read-counter stats (Batch M1) ===
# .claude/hooks/read-counter.sh appends one TSV line per Read tool call here.
# Per-machine, gitignored — drives data-driven follow-up file splits (M2).
.claude-stats/

