# Copy to server/.env.oauth and fill with real values from IBKR OAuth registration.
# NEVER commit the filled version — .env.oauth is gitignored.

# From IBKR Client Portal → OAuth Self-Service after activation:
OAUTH_CONSUMER_KEY=
OAUTH_ACCESS_TOKEN=
OAUTH_ACCESS_TOKEN_SECRET_ENCRYPTED=

# Paths to the private RSA keys you generated with openssl:
OAUTH_SIGNATURE_KEY_PATH=/absolute/path/to/upside-oauth-keys/signature.pem
OAUTH_ENCRYPTION_KEY_PATH=/absolute/path/to/upside-oauth-keys/encryption.pem

# Hex of the Diffie-Hellman prime (the value you uploaded to IBKR's portal).
# To get this from dhparam.pem:
#   openssl dh -in dhparam.pem -text -noout | grep -E '^\s+[0-9a-f]' | tr -d ' :\n'
OAUTH_DH_PRIME=

# Optional overrides; defaults usually fine:
# OAUTH_REALM=limited_poa
# OAUTH_REST_URL=https://api.ibkr.com/v1/api/
