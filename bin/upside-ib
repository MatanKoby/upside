#!/usr/bin/env bash
# bin/upside-ib — call /api/debug/ib-passthrough from the project folder.
#
# Discovers the current tunnel URL from Supabase, reads your JWT from a
# local file, calls the allowlisted IB path you supply. Prints the result
# AND saves it under captures/ in a stable per-call folder, always with a
# `latest.json` pointer so the most recent result for any path is one
# `Read` away.
#
# Usage:
#   ./bin/upside-ib <ib-path> [key=value ...]
#
# Examples (with output paths):
#   ./bin/upside-ib /v1/api/iserver/accounts
#     → captures/iserver/accounts/latest.json
#   ./bin/upside-ib /v1/api/iserver/watchlists
#     → captures/iserver/watchlists/latest.json
#   ./bin/upside-ib /v1/api/iserver/watchlist id=12345
#     → captures/iserver/watchlist/id=12345/latest.json
#   ./bin/upside-ib /v1/api/iserver/contract/265598/info
#     → captures/iserver/contract/265598/info/latest.json
#   ./bin/upside-ib /v1/api/iserver/marketdata/snapshot conids=265598 fields=31,84,86
#     → captures/iserver/marketdata/snapshot/conids=265598&fields=31,84,86/latest.json
#
# History: every call ALSO writes captures/<...>/2026-05-17T08-30Z.json so
# diffs over time are preserved. `latest.json` is just the most recent
# result by copy.
#
# One-time setup:
#   1. Open Upside in browser (laptop Chrome), log in.
#   2. DevTools → Application → Local Storage → https://upside-client.vercel.app
#      → expand sb-<ref>-auth-token → copy the `access_token` value.
#   3. echo 'paste-the-token' > .secrets/supabase-jwt
#
# JWTs expire after ~1 hour. Re-paste when calls start returning 401.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

# ---- Token ----
TOKEN_FILE=".secrets/supabase-jwt"
if [[ ! -f "$TOKEN_FILE" ]]; then
  cat >&2 <<EOF
Missing $TOKEN_FILE.

One-time setup:
  1. Log into Upside in your browser.
  2. DevTools → Application → Local Storage → https://upside-client.vercel.app
     → expand sb-<ref>-auth-token → copy the access_token value.
  3. echo 'paste-the-token' > .secrets/supabase-jwt
EOF
  exit 2
fi
TOKEN="$(tr -d '[:space:]' < "$TOKEN_FILE")"
if [[ -z "$TOKEN" ]]; then
  echo "$TOKEN_FILE is empty." >&2
  exit 2
fi

# ---- Supabase env (publishable key — safe to read from FE env) ----
if [[ ! -f client/.env.local ]]; then
  echo "Missing client/.env.local — expected VITE_SUPABASE_URL + VITE_SUPABASE_PUBLISHABLE_KEY." >&2
  exit 2
fi
# shellcheck disable=SC1091
source client/.env.local
SUPA_URL="${VITE_SUPABASE_URL:-}"
SUPA_KEY="${VITE_SUPABASE_PUBLISHABLE_KEY:-}"
if [[ -z "$SUPA_URL" || -z "$SUPA_KEY" ]]; then
  echo "client/.env.local missing VITE_SUPABASE_URL or VITE_SUPABASE_PUBLISHABLE_KEY." >&2
  exit 2
fi

# ---- Discover api URL from app_config ----
API_URL=$(
  curl -sSf \
    -H "apikey: $SUPA_KEY" \
    -H "Authorization: Bearer $SUPA_KEY" \
    "$SUPA_URL/rest/v1/app_config?select=value&key=eq.api_url" \
    | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d[0]["value"] if d else "")'
)
if [[ -z "$API_URL" ]]; then
  echo "Couldn't read app_config.api_url from Supabase." >&2
  exit 1
fi

# ---- Args ----
# GET (default):  ./bin/upside-ib <ib-path> [key=value ...]
# POST:           ./bin/upside-ib --post '<json-body>' <ib-path>
#   POST forwards the JSON body to IB; only the read-only PortfolioAnalyst paths
#   in the POST allowlist are accepted (see ibPassthroughAllowlist.ts).
METHOD="GET"
POST_BODY=""
if [[ "${1:-}" == "--post" ]]; then
  METHOD="POST"
  POST_BODY="${2:-}"
  if [[ -z "$POST_BODY" ]]; then
    echo "Usage: $0 --post '<json-body>' <ib-path>" >&2
    exit 2
  fi
  shift 2
fi

IB_PATH="${1:-}"
if [[ -z "$IB_PATH" ]]; then
  echo "Usage:" >&2
  echo "  $0 <ib-path> [key=value ...]         # GET" >&2
  echo "  $0 --post '<json-body>' <ib-path>    # POST (read-only PA paths)" >&2
  echo "Allowlist: see server/src/services/ibPassthroughAllowlist.ts" >&2
  exit 2
fi
shift

# ---- Build the passthrough URL ----
# Path is url-encoded so things like /watchlist?id=... never confuse the
# outer query parser. Caller-supplied k=v args are appended verbatim;
# caller is responsible for url-escaping values that need it.
ENCODED_PATH=$(python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1], safe="/"))' "$IB_PATH")
QUERY="path=$ENCODED_PATH"
for kv in "$@"; do
  QUERY="$QUERY&$kv"
done

# ---- Capture directory layout ----
# Folder mirrors the IB path under captures/ (sans /v1/api/), with extra
# k=v args appended as deeper subfolders so re-running with the same args
# always lands in the same place.
#
#   /v1/api/iserver/watchlists           → captures/iserver/watchlists/
#   /v1/api/iserver/watchlist?id=12345   → captures/iserver/watchlist/id=12345/
#   /v1/api/iserver/contract/265598/info → captures/iserver/contract/265598/info/
PATH_NO_PREFIX="${IB_PATH#/v1/api/}"
PATH_NO_PREFIX="${PATH_NO_PREFIX#/}"        # strip leading slash if any
SUBDIR="captures/${PATH_NO_PREFIX}"
if [[ $# -gt 0 ]]; then
  # Sort args so the same set in any order yields the same folder.
  SORTED_ARGS=$(printf '%s\n' "$@" | LC_ALL=C sort | paste -sd'&' -)
  SUBDIR="${SUBDIR}/${SORTED_ARGS}"
fi
# Filesystem-safe: strip anything that isn't a-z, 0-9, dash, dot, slash, =, &
SUBDIR=$(echo "$SUBDIR" | sed 's|[^a-zA-Z0-9./=&_-]|_|g')
# Keep POST captures separate from any GET capture of the same path.
[[ "$METHOD" == "POST" ]] && SUBDIR="${SUBDIR}/POST"

mkdir -p "$SUBDIR"
TS=$(date -u +%Y-%m-%dT%H-%MZ)
TS_FILE="${SUBDIR}/${TS}.json"
LATEST_FILE="${SUBDIR}/latest.json"

# ---- Call + save ----
CURL_ARGS=(-sS -H "Authorization: Bearer $TOKEN" -o "$TS_FILE" -w '%{http_code}')
if [[ "$METHOD" == "POST" ]]; then
  CURL_ARGS+=(-X POST -H "Content-Type: application/json" --data "$POST_BODY")
fi
HTTP_STATUS=$(curl "${CURL_ARGS[@]}" "$API_URL/api/debug/ib-passthrough?$QUERY")
cp "$TS_FILE" "$LATEST_FILE"

# Print summary to stderr, body to stdout.
{
  echo
  echo "HTTP $HTTP_STATUS"
  echo "  latest : $LATEST_FILE"
  echo "  archive: $TS_FILE"
} >&2

if command -v python3 >/dev/null 2>&1; then
  python3 -m json.tool < "$LATEST_FILE" 2>/dev/null || cat "$LATEST_FILE"
else
  cat "$LATEST_FILE"
fi
echo
