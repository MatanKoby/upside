# Copy to .env on the VPS and fill in real values.
# NEVER commit .env. The Oracle VPS is the only place this file should exist.

# ---- Upside auth whitelist ------------------------------------------------
UPSIDE_ALLOWED_EMAILS=email1@gmail.com,email2@gmail.com

# ---- Supabase --------------------------------------------------------------
# Using Supabase's new key system (publishable + secret). Legacy "anon" and
# "service_role" keys still work as values but we name them per the new system.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# ---- Google OAuth (Supabase handles the dance, but client ID is needed) ----
GOOGLE_OAUTH_CLIENT_ID=

# ---- LLM provider (gemini | claude | openai) -------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- External data sources -------------------------------------------------
FINNHUB_API_KEY=

# ---- Internal --------------------------------------------------------------
# IB_GATEWAY_URL, REDIS_URL, and CLOUDFLARED_LOG_PATH are hardcoded in
# docker-compose.yml's `api` service `environment:` block — they're internal
# compose-network addresses, not user-configurable. Leaving them out of .env
# avoids the "env_file overridden by environment:" confusion we hit in Batch 10.
PORT=3001
NODE_ENV=production

# IMPORTANT: IB credentials are NEVER in env vars.
# They are entered by the user in-browser, stored only in the user's password
# manager, and proxied at login time. The resulting session token lives in
# Redis with a 24h TTL keyed by Supabase user ID.

# ---- Vercel (FE) env vars — for reference, not loaded by the BE ------------
# Set on Vercel project settings, not in this file:
#   VITE_SUPABASE_URL             — same as SUPABASE_URL above
#   VITE_SUPABASE_PUBLISHABLE_KEY — same as SUPABASE_PUBLISHABLE_KEY above
# NOTE: there is intentionally no VITE_API_URL. The FE discovers the api's
# public URL from Supabase app_config at runtime (populated by the tunnel
# watcher in the BE; see UPSIDE_MVP_SPEC.md → "Public URL Discovery").
